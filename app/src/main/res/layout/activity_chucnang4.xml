<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Ảnh sinh viên -->
        <ImageView
            android:id="@+id/imgSinhVien"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerCrop"
            android:layout_marginBottom="16dp"/>

        <!-- Họ và tên -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Họ và Tên:"
            android:textSize="13sp"
            android:textColor="#757575"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Võ Tuấn Đạt"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginBottom="16dp"/>

        <!-- Mã số -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mã số sinh viên:"
            android:textSize="13sp"
            android:textColor="#757575"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="65130451"
            android:textSize="18sp"
            android:textColor="#333333"
            android:layout_marginBottom="16dp"/>

        <!-- Lớp -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lớp:"
            android:textSize="13sp"
            android:textColor="#757575"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="65CNTT-2"
            android:textSize="18sp"
            android:textColor="#333333"
            android:layout_marginBottom="16dp"/>

        <!-- Sở thích -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sở thích:"
            android:textSize="13sp"
            android:textColor="#757575"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lập trình, Du lịch, Chơi game"
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginBottom="16dp"/>

        <!-- Sở trường -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sở trường:"
            android:textSize="13sp"
            android:textColor="#757575"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lập trình Android, Java"
            android:textSize="16sp"
            android:textColor="#333333"/>

    </LinearLayout>
</ScrollView>