<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tính Chu Vi và Diện Tích"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chiều dài (m):"
        android:textSize="16sp"
        android:textColor="#333333"/>

    <EditText
        android:id="@+id/edtChieuDai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập chiều dài"
        android:inputType="numberDecimal"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chiều rộng (m):"
        android:textSize="16sp"
        android:textColor="#333333"/>

    <EditText
        android:id="@+id/edtChieuRong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập chiều rộng"
        android:inputType="numberDecimal"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnTinhToan"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Tính Toán"
        android:backgroundTint="#3F51B5"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp"/>

    <!-- Hiển thị kết quả -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvChuVi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chu vi: ---"
                android:textSize="18sp"
                android:textColor="#1A237E"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDienTich"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diện tích: ---"
                android:textSize="18sp"
                android:textColor="#E91E63"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>